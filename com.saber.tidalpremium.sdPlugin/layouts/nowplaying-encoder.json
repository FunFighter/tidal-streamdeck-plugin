{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
  "id": "com.saber.tidalpremium.nowplaying.encoder",
  "items": [
    {
      "key": "bg",
      "type": "pixmap",
      "rect": [0, 0, 200, 100]
    },
    {
      "key": "title",
      "type": "text",
      "rect": [12, 10, 176, 22],
      "zOrder": 1,
      "font": { "size": 16, "weight": 700 },
      "alignment": "left",
      "text-overflow": "fade",
      "color": "#ffffff"
    },
    {
      "key": "artist",
      "type": "text",
      "rect": [12, 38, 176, 18],
      "zOrder": 1,
      "font": { "size": 13, "weight": 500 },
      "alignment": "left",
      "text-overflow": "fade",
      "color": "#d9e1eb"
    }
  ]
}
